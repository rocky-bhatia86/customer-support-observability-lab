OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
# Leave blank to call OpenAI's own API. Set to any OpenAI-compatible gateway
# (e.g. a Databricks Model Serving endpoint's "https://<workspace>/serving-endpoints")
# to point at a different provider/model with zero code changes -- just also
# update OPENAI_API_KEY and MODEL_NAME to match that provider.
OPENAI_BASE_URL=
TEMPERATURE=0.2
MAX_AGENT_ITERATIONS=5
# v2 is intentionally stricter -- simulates last week's model/prompt bump.
# Set to v1 to reproduce the pre-bump (baseline) checker behavior for
# side-by-side comparison.
CHECKER_PROMPT_VERSION=v2
