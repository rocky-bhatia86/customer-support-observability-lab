OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
# Leave blank to call OpenAI's own API. Set to any OpenAI-compatible gateway
# (e.g. a Databricks Model Serving endpoint's "https://<workspace>/serving-endpoints")
# to point at a different provider/model with zero code changes -- just also
# update OPENAI_API_KEY and MODEL_NAME to match that provider.
OPENAI_BASE_URL=
TEMPERATURE=0.2
MAX_AGENT_ITERATIONS=5
# v1 (default here) is the pre-bump baseline -- start here so the system
# looks and behaves normally. v2 is intentionally stricter, simulating
# last week's model/prompt bump; flip to it live from the chat UI's
# checker toggle (no restart needed) to see the same code regress.
CHECKER_PROMPT_VERSION=v1

# Langfuse observability. Leave all three blank to run with tracing fully
# disabled (no spans created, no network calls attempted) -- see README
# "Langfuse setup". Once you have a project, set all three together:
# LANGFUSE_HOST: https://cloud.langfuse.com, https://us.cloud.langfuse.com,
# or your self-hosted URL (e.g. http://localhost:3000).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
